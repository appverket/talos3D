+// Keep shadow-casting keys ahead of unshadowed fills when a backend truncates
+// the directional-light list (WebGL supports only one directional light).
+fn directional_light_priority<T: Ord>(
+    volumetric: bool,
+    shadows: bool,
+    entity: T,
+) -> (bool, bool, T) {
+    (!volumetric, !shadows, entity)
+}
+
+#[cfg(test)]
+mod directional_light_priority_tests {
+    use super::directional_light_priority;
+
+    #[test]
+    fn one_light_backend_retains_shadowed_key_before_fill() {
+        let mut lights = [(false, false, 1u32), (false, true, 9u32)];
+        lights.sort_by_key(|&(v, s, id)| directional_light_priority(v, s, id));
+        let retained: Vec<_> = lights.iter().take(1).collect();
+        assert_eq!(retained[0].2, 9);
+        assert_eq!(retained.iter().filter(|l| l.1).count(), 1);
+    }
+
+    #[test]
+    fn priority_is_volumetric_then_shadow_then_stable_identity() {
+        let mut lights = [
+            (false, false, 0u32),
+            (false, true, 7),
+            (true, true, 8),
+            (false, true, 3),
+        ];
+        lights.sort_by_key(|&(v, s, id)| directional_light_priority(v, s, id));
+        assert_eq!(lights.map(|l| l.2), [8, 3, 7, 0]);
+        assert_eq!(lights.iter().take(2).filter(|l| l.0).count(), 1);
+        assert_eq!(lights.iter().take(2).filter(|l| l.1).count(), 2);
+    }
+}
